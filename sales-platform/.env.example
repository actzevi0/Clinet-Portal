# Postgres connection. For local dev use docker-compose.yml.
DATABASE_URL="postgresql://sales:sales@localhost:5432/sales_platform?schema=public"

# NextAuth
AUTH_SECRET="change-me-32-char-random"
AUTH_URL="http://localhost:3001"

# Object storage for documents (R2/S3 compatible)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Webhook ingestion shared secret
WEBHOOK_SECRET=""

# Integration with the existing analysis system (EasyFinance / Cloudflare D1)
ANALYSIS_API_BASE=""
ANALYSIS_API_TOKEN=""
